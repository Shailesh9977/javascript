let employees = [
  { name: "Aman", salary: 30000 },
  { name: "Rahul", salary: 50000 },
  { name: "Rohit", salary: 40000 },
];

let ans = employees.reduce((acc, curr) => {
  if (curr.salary > acc.salary) {
    return curr;
  }
  return acc;
});

console.log(ans);

