let students = [
  { name: "A", marks: 80 },
  { name: "B", marks: 35 },
  { name: "C", marks: 70 },
  { name: "D", marks: 25 },
  { name: "E", marks: 60 },
];

let aans = students.reduce((acc, curr) => {
  if (curr.marks >= 40) {
    return acc + 1;
  }
  return acc;
}, 0);

console.log(aans);

let products = [
  { name: "Laptop", price: 50000 },
  { name: "Mouse", price: 1000 },
  { name: "Keyboard", price: 2000 },
];

let total = products.reduce((acc, curr) => {
  return acc + curr.price;
}, 0);

